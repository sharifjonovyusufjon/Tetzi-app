<%- include('includes/header') %>
<link rel="stylesheet" type="text/css" href="/css/journals.css" />
<body>
  <div class="journals-page">
    <div class="container">
      <div class="menu-box">
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin">Home</a>
        </li>
        <% if(!member) { %>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/member/signup">Signup</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/member/login">Login</a>
        </li>
        <% } else { %>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/product/all">Menu</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/journal/all">Journals</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/member/all">Users</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/order/all">Orders</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/comment/all">Comments</a>
        </li>
        <li
          class="nav-item"
          style="cursor: pointer"
          onclick="return confirm('Do you want to logout?')"
        >
          <a class="nav-link" href="/admin/member/logout">Logout</a>
        </li>

        <% } %>
      </div>
      <div class="boxes">
        <div class="menu-title">Journals List</div>
        <div class="menu">
          <table class="table">
            <thead>
              <th>T/r</th>
              <th>JournalTitle</th>
              <th>JournalContext</th>
              <th>Status</th>
            </thead>

            <% journals.map((value, key) => { %>
            <tbody>
              <td><%= key+1 %></td>
              <td><%= value.journalTitle %></td>
              <td><%= value.journalContext %></td>
              <td>
                <select class="journal-status" id="<%= value._id %>">
                  <option value="PAUSE" <%= value.journalStatus === 'PAUSE' ? 'selected' : '' %>>PAUSE</option>
                  <option value="PROCESS" <%= value.journalStatus === 'PROCESS' ? 'selected' : '' %>>PROCESS</option>
                  <option value="DELETE" <%= value.journalStatus === 'DELETE' ? 'selected' : '' %>>DELETE</option>
                </select>
              </td>
            </tbody>
            <% }) %>
          </table>
        </div>
      </div>
      <div class="new-box">
        <button class="new-button">Add New Journal</button>
        <form class="product-container"
        action="/admin/journal/create"
        method="POST"
        enctype="multipart/form-data"
        onsubmit="return validateJournalForm()"
        style="display: none;">
        <div class="form-box">
          <strong>New Journal Creation</strong>
          <div class="box">
            <div class="input-box">
              <span>Journal Title</span>
              <input type="text" placeholder="Journal Title" class="journal-title" name="journalTitle">
            </div>
            <div class="input-box">
              <span>Journal Category</span> <select name="journalCategory" class="journal-category" id="">
                <option value="TOYS">TOYS</option>
                <option value="CLOTHES">CLOTHES</option>
                <option value="PAMPERS">PAMPERS</option>
                <option value="STROLLER">STROLLER</option>
              </select>
            </div>
          </div>
          <div class="box">
            <div class="input-box-m">
              <span>Journal  Context</span>
              <input type="text" placeholder="Journal  Context" class="journal-desc" name="journalContext">
            </div>
          </div>
          <div class="image-box">
            <div class="upload-img-box">
              <img src="/img/image-upload.jpg" class="one" id="image-section" />
              <input
                type="file"
                id="file"
                name="journalImage"
                class="image-one"
                required
                onchange="/*previewFileHandler(this, 1)*/"
              />
            </div>
          </div>
        </div>
          <div class="button-box">
            <button class="cancel-button" type="button">Cancel</button> 
            <button class="create-button" type="submit">Create</button>
          </div>
        </form>
      </div>
    </div>
  </div>
  <script src="/js/journals.js"></script>
</body>
<%- include('includes/footer') %>
