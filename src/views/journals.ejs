<%- include('includes/header') %>
<link rel="stylesheet" type="text/css" href="/css/journals.css" />
<body>
  <div class="journals-page">
    <div class="container">
      <div class="menu-box">
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin">Home</a>
        </li>
        <% if(!member) { %>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/member/signup">Signup</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/member/login">Login</a>
        </li>
        <% } else { %>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/product/all">Menu</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/journal/all">Journals</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/member/all">Users</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/order/all">Orders</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/comment/all">Comments</a>
        </li>
        <li
          class="nav-item"
          style="cursor: pointer"
          onclick="return confirm('Do you want to logout?')"
        >
          <a class="nav-link" href="/admin/member/logout">Logout</a>
        </li>

        <% } %>
      </div>
      <div class="boxes">
        <% journals.map((value, key) => { %>
        <div><%= value.journalTitle %></div>
        <% }) %>
      </div>
    </div>
  </div>
  <script src="/js/journals.js"></script>
</body>
<%- include('includes/footer') %>
