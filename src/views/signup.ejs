<%- include('includes/header') %>
<link rel="stylesheet" type="text/css" href="/css/signup.css" />
<body>
  <div class="signup-page">
    <div class="container">
      <div class="signup">
        <strong>Sign-Up</strong>
        <form
          action="/admin/member/signup"
          method="post"
          onsubmit="return validateSignupForm()"
          enctype="multipart/form-data"
        >
          <div class="signup-box">
            <div class="box">
              <span>First Name</span>
              <input
                class="member-first-name"
                type="text"
                name="memberFirstName"
                placeholder="First Name"
                required
              />
            </div>

            <div class="box">
              <span>Last Name</span>
              <input
                type="text"
                class="member-last-name"
                name="memberLastName"
                placeholder="Last Name"
                required
              />
            </div>
          </div>

          <div class="signup-box">
            <div class="box">
              <span>Email Address</span>
              <input
                type="text"
                name="memberEmail"
                class="member-email"
                placeholder="company@gmail.com"
                required
              />
            </div>

            <div class="box">
              <span>Telephone</span>
              <input
                type="text"
                name="memberPhone"
                class="member-phone"
                placeholder="Your Phone Number"
                required
              />
            </div>
          </div>

          <div class="signup-box">
            <div class="box">
              <span>Address 1</span>
              <input
                type="text"
                name="memberAddress"
                class="member-address1"
                placeholder="4279 boncak Port Suite 780-9"
                required
              />
            </div>

            <div class="box">
              <span>Address 2</span>
              <input
                type="text"
                name="memberAddress"
                class="member-address2"
                placeholder="-------"
                required
              />
            </div>
          </div>

          <div class="signup-box">
            <div class="box">
              <span>City</span>
              <input
                type="text"
                name="memberCity"
                class="member-city"
                placeholder="Your City"
                required
              />
            </div>

            <div class="box">
              <span>Post Code</span>
              <input
                type="text"
                name="memberPostCode"
                class="member-post"
                placeholder="78906"
                required
              />
            </div>
          </div>

          <div class="signup-box">
            <div class="box">
              <span>Password</span>
              <input
                type="text"
                name="memberPassword"
                class="member-password"
                placeholder="Password"
                required
              />
            </div>

            <div class="box">
              <span>Repeat Password</span>
              <input
                type="text"
                name="memberRepeadPassword"
                class="member-confirm-password"
                placeholder="Repead Password"
                required
              />
            </div>
          </div>

          <div class="signup-box">
            <div class="box">
              <img class="upload-img" src="/img/logo.png" alt="" />
            </div>

            <div class="box">
              <div class="file-input" for="file-in">
                <span style="margin-top: 0px; padding-top: 22px"
                  >Choose image</span
                >
                <label for="file-in" class="uploads-img">Upload</label>
              </div>
              <input
                style="display: none"
                type="file"
                name="memberImage"
                id="file-in"
                placeholder="Choose image"
                required
              />
              <p>Please upload image only: jpg, jpeg or png formats allowed!</p>
            </div>
          </div>
          <button type="submit">Signup</button>
        </form>
        <p>
          Save in account?
          <a href="/admin/member/login">Login</a>
        </p>
      </div>
    </div>
  </div>
  <script src="/js/signup.js"></script>
</body>
<%- include('includes/footer') %>
