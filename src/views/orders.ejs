<%- include('includes/header') %>
<link rel="stylesheet" type="text/css" href="/css/orders.css" />
<body>
  <div class="orders-page">
    <div class="container">
      <div class="menu-box">
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin">Home</a>
        </li>
        <% if(!member) { %>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/member/signup">Signup</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/member/login">Login</a>
        </li>
        <% } else { %>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/product/all">Menu</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/journal/all">Journals</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/member/all">Users</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/order/all">Orders</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/comment/all">Comments</a>
        </li>
        <li
          class="nav-item"
          style="cursor: pointer"
          onclick="return confirm('Do you want to logout?')"
        >
          <a class="nav-link" href="/admin/member/logout">Logout</a>
        </li>

        <% } %>
      </div>
      <div class="boxes">
        <div class="menu-title">Orders List</div>
        <div class="menu">
          <table class="table">
            <thead>
              <th>T/r</th>
              <th>OrderTotal</th>
              <th>OrderDelivery</th>
              <th>Status</th>
            </thead>

            <% orders.map((value, key) => { %>
            <tbody>
              <td><%= key+1 %></td>
              <td><%= value.orderTotal %></td>
              <td><%= value.orderDelivery %></td>
              <td>
                <select class="" id="<%= value._id %>">
                  <option value="PAUSE" <%= value.memberStatus === 'PAUSE' ? 'selected' : '' %>>PAUSE</option>
                  <option value="PROCESS" <%= value.memberStatus === 'PROCESS' ? 'selected' : '' %>>PROCESS</option>
                  <option value="FINISH" <%= value.memberStatus === 'FINISH' ? 'selected' : '' %>>FINISH</option>
                </select>
              </td>
            </tbody>
            <% }) %>
          </table>
        </div>
      </div>
    </div>
  </div>
  <script src="/js/orders.js"></script>
</body>
<%- include('includes/footer') %>
