<%- include('includes/header') %>
<link rel="stylesheet" type="text/css" href="/css/comments.css" />
<body>
  <div class="comments-page">
    <div class="container">
      <div class="menu-box">
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin">Home</a>
        </li>
        <% if(!member) { %>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/member/signup">Signup</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/member/login">Login</a>
        </li>
        <% } else { %>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/product/all">Menu</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/journal/all">Journals</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/member/all">Users</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/order/all">Orders</a>
        </li>
        <li class="nav-item" style="cursor: pointer">
          <a class="nav-link" href="/admin/comment/all">Comments</a>
        </li>
        <li
          class="nav-item"
          style="cursor: pointer"
          onclick="return confirm('Do you want to logout?')"
        >
          <a class="nav-link" href="/admin/member/logout">Logout</a>
        </li>

        <% } %>
      </div>
      <div class="boxes">
        <div class="menu-title">Comments List</div>
        <div class="menu">
          <table class="table">
            <thead>
              <th>T/r</th>
              <th>CommentContext</th>
              <th>CommentDelete</th>
            </thead>

            <% comments.map((value, key) => { %>
            <tbody>
              <td><%= key+1 %></td>
              <td><%= value.commentContext %></td>
              <td>
                <button id="<%= value._id %>">DELETE</button>
              </td>
            </tbody>
            <% }) %>
          </table>
        </div>
      </div>
    </div>
  </div>
  <script src="/js/comments.js"></script>
</body>
<%- include('includes/footer') %>
